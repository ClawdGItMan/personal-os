# Copy to `.env` and fill in. These are the Personal OS Supabase project's
# PUBLIC values (safe to ship in a client) — the same backend the web app uses.
# Get them from: Supabase dashboard → Project Settings → API, or `vercel env pull`.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
