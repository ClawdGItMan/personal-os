NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production base URL (also used by the magic-link auth flow + OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service-role key — server-only secret, used by cron sync (bypasses RLS). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth app (Calendar read-only for 1B.1a; Gmail added in 1B.1b)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# AES-256-GCM key for token encryption at rest (base64 of 32 bytes: `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key

# Shared secret asserted by the Vercel Cron sync route (`openssl rand -hex 32`)
CRON_SECRET=your-cron-secret

# Whoop OAuth app (developer.whoop.com)
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret
WHOOP_OAUTH_REDIRECT_URI=http://localhost:3000/api/whoop/callback
